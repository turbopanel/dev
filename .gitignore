.deno/
deno.lock
node_modules
.pnpm-store/
.cursor/debug-*.log

# Kernel core dumps (a guest `core` file is ~1 GB and is not source)
/core
*.core

# Local Ansible state (committed config lives under orchestration/)
.ansible/

# Vagrant machine state (UTM guest; Vagrantfile is committed)
.vagrant/

# env and secret-bearing dotenv variants
.env
.env.*
.env-*
.envrc
!.env.example
.dev.vars
.dev.vars*
!.dev.vars.example

# keys, certs, tokens, and passwords
*.pem
*.key
*.p12
*.jks
*.mobileprovision
*.token
*.secret
*.pass
server-key.json
license.token
certs/

# logs and runtime state
logs/
.local/
.cache/
.config/
coverage/

# macOS Finder metadata
.DS_Store

# Local Claude Code settings (background-session isolation)
.claude/settings.json

# Machine-local dev secrets and saved catalogue (survive a VM rebuild because
# the checkout is mounted into the guest). Only the README and examples are tracked.
/local/*
!/local/README.md
!/local/*.example
